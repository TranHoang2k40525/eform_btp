<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Nhận diện và trích xuất">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="2" value="QUY TRÌNH NHẬN DIỆN VÀ TRÍCH XUẤT DỮ LIỆU BẢNG EXCEL" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="210" y="30" width="1180" height="50" as="geometry"/></mxCell>
        <mxCell id="3" value="Tệp Excel báo cáo&#xa;Bố cục, vị trí bảng và số tầng tiêu đề có thể khác nhau" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="4" value="Biểu diễn trang tính thành lưới ô&#xa;Ghi nhận loại dữ liệu, vị trí, ô gộp và định dạng" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=15;" vertex="1" parent="1"><mxGeometry x="470" y="150" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="5" value="Mô hình nhận diện vai trò của ô&#xa;Ngoài bảng · Tiêu đề · Giá trị" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=3;double=1;fontColor=#000000;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="880" y="150" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="6" value="Xác định phạm vi bảng&#xa;Hàng/cột bắt đầu · Hàng/cột kết thúc · Hàng cuối tiêu đề" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1230" y="380" width="310" height="130" as="geometry"/></mxCell>
        <mxCell id="7" value="Đọc trực tiếp nội dung trong phạm vi đã xác định&#xa;Giữ nguyên giá trị, ô gộp, công thức và định dạng" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=15;" vertex="1" parent="1"><mxGeometry x="780" y="380" width="330" height="130" as="geometry"/></mxCell>
        <mxCell id="8" value="Tạo cấu trúc tiêu đề cho từng cột&#xa;Tiêu đề cha → Tiêu đề con → Mã cột" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=15;" vertex="1" parent="1"><mxGeometry x="330" y="380" width="320" height="130" as="geometry"/></mxCell>
        <mxCell id="9" value="Dữ liệu xem trước&#xa;Hiển thị đúng cấu trúc bảng để người dùng kiểm tra trước khi nhập" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=3;fontColor=#000000;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="590" y="650" width="420" height="130" as="geometry"/></mxCell>
        <mxCell id="10" value="Nguyên tắc bảo toàn dữ liệu: mô hình xác định vùng cần đọc; nội dung được lấy trực tiếp từ tệp Excel, không được tự tạo lại." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;dashed=1;strokeWidth=2;fontColor=#000000;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="850" width="920" height="60" as="geometry"/></mxCell>
        <mxCell id="20" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#000000;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="3" target="4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="21" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#000000;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="4" target="5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="22" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#000000;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="5" target="6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#000000;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="6" target="7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="24" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#000000;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="7" target="8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="25" value="Nội dung và cấu trúc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#000000;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="8" target="9"><mxGeometry relative="1" as="geometry"/></mxCell>
