        <mxCell id="28" value="Đạt" style="edgeStyle=none;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#000000;strokeWidth=2;exitX=0.75;exitY=0.75;entryX=0;entryY=0.5;" edge="1" parent="1" source="11" target="12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="29" value="Chưa đạt" style="edgeStyle=none;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeColor=#000000;strokeWidth=2;exitX=0.25;exitY=0.75;entryX=0.5;entryY=0;" edge="1" parent="1" source="11" target="13"><mxGeometry relative="1" as="geometry"/></mxCell>
