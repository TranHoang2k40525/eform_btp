<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="Xây dựng bộ dữ liệu">
    <mxGraphModel dx="1300" dy="900" grid="1" gridSize="10" guides="1" page="1" pageWidth="1500" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="2" value="QUY TRÌNH XÂY DỰNG VÀ KIỂM SOÁT CHẤT LƯỢNG BỘ DỮ LIỆU" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="170" y="30" width="1160" height="50" as="geometry"/></mxCell>
        <mxCell id="3" value="1. Thu thập tệp Excel báo cáo&#xa;Bảo toàn hàng, cột, ô gộp và định dạng" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="130" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="4" value="2. Kiểm tra tệp và loại bản sao&#xa;Giữ một bản đại diện cho các tệp giống nhau" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=15;" vertex="1" parent="1"><mxGeometry x="440" y="130" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="5" value="3. Phân tích từng trang tính&#xa;Xem xét nội dung, kiểu dữ liệu, ô gộp, đường viền và hàng mã" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=15;" vertex="1" parent="1"><mxGeometry x="830" y="120" width="330" height="130" as="geometry"/></mxCell>
        <mxCell id="6" value="4. Gán nhãn vùng bảng&#xa;Xác định ranh giới bảng và hàng cuối của phần tiêu đề" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=3;double=1;fontColor=#000000;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1190" y="360" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="7" value="5. Kiểm duyệt mẫu quan trọng&#xa;Ưu tiên bố cục hiếm, nhiều bảng, ghi chú sát bảng và nhãn có cảnh báo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=15;" vertex="1" parent="1"><mxGeometry x="790" y="350" width="320" height="140" as="geometry"/></mxCell>
        <mxCell id="8" value="6. Nhóm các mẫu có bố cục tương tự&#xa;Phục vụ chia tập và đánh giá khả năng xử lý cấu trúc mới" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=15;" vertex="1" parent="1"><mxGeometry x="390" y="350" width="320" height="140" as="geometry"/></mxCell>
        <mxCell id="9" value="7. Chia tập dữ liệu&#xa;Huấn luyện · Xác thực · Kiểm tra cùng miền · Kiểm tra khác miền" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="350" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="10" value="8. Tạo biến thể cho tập huấn luyện&#xa;Dịch vị trí, giảm tín hiệu định dạng và che một phần tiêu đề" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=15;" vertex="1" parent="1"><mxGeometry x="150" y="660" width="330" height="130" as="geometry"/></mxCell>
        <mxCell id="11" value="9. Kiểm tra chất lượng&#xa;Tọa độ hợp lệ · Không chồng lấn · Không rò rỉ giữa các tập" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="590" y="640" width="300" height="170" as="geometry"/></mxCell>
        <mxCell id="12" value="10. Bộ dữ liệu sẵn sàng huấn luyện&#xa;Kèm thống kê, cảnh báo và thông tin truy vết" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=3;fontColor=#000000;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1010" y="660" width="330" height="130" as="geometry"/></mxCell>
        <mxCell id="13" value="Chưa đạt" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;dashed=1;strokeWidth=2;fontColor=#000000;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580" y="900" width="320" height="80" as="geometry"/></mxCell>
        <mxCell id="14" value="Bổ sung hoặc sửa nhãn, sau đó kiểm tra lại" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="570" y="985" width="340" height="30" as="geometry"/></mxCell>
