@{ Layout = null; }
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Import dữ liệu Excel</title>
    <link rel="stylesheet" href="/Content/import.css" />
</head>
<body>
    <div class="toolbar">
        <button type="button">⬇ Tải template</button>
        <button type="button" id="import">📁 Import dữ liệu</button>
        <button type="button" class="primary" id="confirm">✅ Nhập dữ liệu</button>
    </div>
    <div class="modal">
        <h2>Import dữ liệu Excel</h2>
        <input id="file" type="file" accept=".xlsx,.xlsm" />
        <input id="userId" placeholder="UserId" value="test-user" />
        <input id="documentId" placeholder="DocumentId" value="document-test-001" />
        <input id="docTypeCode" placeholder="DocTypeCode, ví dụ 04b" />
        <input id="formIndex" type="number" min="0" value="0" title="Vị trí form trong DocumentContents" />
        <textarea id="targetSchemaJson" rows="8" placeholder="Dán JSON document eForm có DocumentContents/FormConfig"></textarea>
        <span id="status">Chưa có dữ liệu</span>
    </div>
    <div class="grid"><table id="table" border="1" cellpadding="8"></table></div>
    <div class="side">
        <h3>Cảnh báo dữ liệu</h3>
        <select><option>Tất cả</option></select>
        <p id="summary">Chưa có dữ liệu</p>
    </div>
    <script>
        const fileInput = document.getElementById('file');
        const status = document.getElementById('status');
        const summary = document.getElementById('summary');
        const table = document.getElementById('table');

        document.getElementById('import').onclick = () => fileInput.click();
        fileInput.onchange = async event => {
            const selected = event.target.files[0];
            if (!selected) return;
            const schema = document.getElementById('targetSchemaJson').value.trim();
            if (!schema) {
                status.textContent = 'Thiếu JSON schema của biểu đích.';
                return;
            }
            const form = new FormData();
            form.append('file', selected);
            form.append('userId', document.getElementById('userId').value);
            form.append('documentId', document.getElementById('documentId').value);
            form.append('docTypeCode', document.getElementById('docTypeCode').value);
            form.append('formIndex', document.getElementById('formIndex').value || '0');
            form.append('targetSchemaJson', schema);
            status.textContent = 'Đang xử lý...';
            table.textContent = '';
            try {
                const response = await fetch('/api/import/parse', { method: 'POST', body: form });
                const result = await response.json();
                status.textContent = result.message || (response.ok ? 'Đã xử lý' : 'Xử lý thất bại');
                summary.textContent = `${result.rowCount || 0} dòng - ${result.errorCount || 0} lỗi`
                    + (result.requiresReview ? ' - cần duyệt ánh xạ' : '');
                renderRows(Array.isArray(result.data) ? result.data : []);
            } catch (error) {
                status.textContent = 'Không gọi được API: ' + error.message;
            }
        };

        function renderRows(rows) {
            if (!rows.length) return;
            const keys = [...new Set(rows.flatMap(row => Object.keys(row)))];
            const head = table.createTHead().insertRow();
            keys.forEach(key => {
                const cell = document.createElement('th');
                cell.textContent = key;
                head.appendChild(cell);
            });
            const body = table.createTBody();
            rows.forEach(row => {
                const tr = body.insertRow();
                keys.forEach(key => {
                    const cell = tr.insertCell();
                    cell.textContent = row[key] == null ? '' : String(row[key]);
                });
            });
        }
    </script>
</body>
</html>
