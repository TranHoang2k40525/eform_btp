@{ Layout = null; }
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AI Import Excel | eForm BTP</title>
    <link rel="stylesheet" href="/Content/handsontable.full.min.css" />
    <link rel="stylesheet" href="/Content/import.css" />
</head>
<body>
    <div class="import-app">
        <header class="app-header">
            <div>
                <p class="eyebrow">eForm BTP · AI Import</p>
                <h1>Nhập dữ liệu từ file Excel</h1>
                <p class="subtitle">Tải workbook lên, hệ thống bóc tách cấu trúc bằng AI, lưu kết quả và dựng lại bảng xem trước.</p>
            </div>
            <div id="serviceStatus" class="service-status" aria-live="polite">
                <span class="status-dot"></span><span id="serviceStatusText">Đang kiểm tra AI...</span>
            </div>
        </header>

        <main>
            <section class="upload-card" aria-labelledby="uploadTitle">
                <div class="section-heading">
                    <div>
                        <span class="step">01</span>
                        <h2 id="uploadTitle">Chọn file Excel</h2>
                    </div>
                    <span class="file-rule">.xlsx hoặc .xlsm · tối đa 50 MB</span>
                </div>
                <div id="dropZone" class="drop-zone" tabindex="0">
                    <div class="upload-icon" aria-hidden="true">↑</div>
                    <strong>Kéo thả file Excel vào đây</strong>
                    <span>hoặc</span>
                    <button id="chooseFileButton" type="button" class="primary-button">Chọn file từ máy</button>
                    <p id="selectedFile" class="selected-file">Chưa chọn file</p>
                </div>
                <div id="uploadError" class="message error-message" hidden role="alert"></div>
                <div class="upload-actions">
                    <button id="importButton" type="button" class="primary-button" disabled>Nhập và phân tích</button>
                    <button id="clearButton" type="button" class="secondary-button" disabled>Xóa lựa chọn</button>
                </div>
                <div id="progress" class="progress-area" hidden aria-live="polite">
                    <div class="progress-track"><span id="progressBar"></span></div>
                    <span id="progressText">Đang gửi file tới AI...</span>
                </div>
                <input id="fileInput" type="file" accept=".xlsx,.xlsm" hidden />
            </section>

            <section id="resultSection" class="result-card" hidden aria-labelledby="resultTitle">
                <div class="section-heading result-heading">
                    <div>
                        <span class="step">02</span>
                        <h2 id="resultTitle">Kết quả bóc tách</h2>
                    </div>
                    <span id="saveStatus" class="save-status"></span>
                </div>
                <div class="result-meta">
                    <div><span>File</span><strong id="resultFileName">-</strong></div>
                    <div><span>Sheet</span><strong id="resultSheetName">-</strong></div>
                    <div><span>Vùng dữ liệu</span><strong id="resultRange">-</strong></div>
                    <div><span>Số dòng dữ liệu</span><strong id="resultRowCount">0</strong></div>
                    <div><span>Số cột</span><strong id="resultColumnCount">0</strong></div>
                </div>
                <div id="resultMessage" class="message" hidden></div>
                <div class="table-help">Bảng chỉ đọc · cuộn dọc/ngang để xem toàn bộ kết quả từ Excel</div>
                <div id="sheetTabs" class="sheet-tabs" hidden></div>
                <div id="gridHost" class="grid-host">
                    <div id="hotContainer" aria-label="Bảng kết quả Excel"></div>
                </div>
            </section>
        </main>
    </div>
    <script src="/Scripts/handsontable.full.min.js"></script>
    <script src="/Scripts/import-preview.js"></script>
</body>
</html>
