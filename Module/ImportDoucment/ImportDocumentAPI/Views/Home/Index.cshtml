@{ Layout = null; }<!doctype html>
<html lang="vi">
<head>
	<meta charset="utf-8" />
	<title>Import dữ liệu Excel</title>
	<link rel="stylesheet" href="/Content/import.css" />
</head>
<body>
	<div class="toolbar"><button>⬇ Tải template</button><button id="import">📁 Import dữ liệu</button><button class="primary" id="confirm">✅ Nhập dữ liệu</button></div><div class="modal"><h2>Import dữ liệu Excel</h2><input id="file" type="file" accept=".xlsx,.xls" /><input id="userId" placeholder="UserId" value="test-user" /><input id="documentId" placeholder="DocumentId" value="document-test-001" /><span id="status">Chưa có dữ liệu</span></div><div class="grid"><table id="table" border="1" cellpadding="8"></table></div><div class="side"><h3>Cảnh báo dữ liệu</h3><select><option>Tất cả</option></select><p id="summary">Chưa có dữ liệu</p></div>
	<script>const file = document.getElementById('file'); document.getElementById('import').onclick = () => file.click(); file.onchange = async e => { let f = e.target.files[0]; if (!f) return; let d = new FormData(); d.append('file', f); d.append('userId', document.getElementById('userId').value); d.append('documentId', document.getElementById('documentId').value); document.getElementById('status').textContent = 'Đang xử lý...'; let r = await fetch('/api/import/parse', { method: 'POST', body: d }); let j = await r.json(); document.getElementById('status').textContent = j.message || 'Đã xử lý'; document.getElementById('summary').textContent = (j.rowCount || 0) + ' dòng hợp lệ - ' + (j.errorCount || 0) + ' lỗi'; if (Array.isArray(j.data) && j.data.length) { let keys = Object.keys(j.data[0]); document.getElementById('table').innerHTML = '<tr>' + keys.map(k => '<th>' + k + '</th>').join('') + '</tr>' + j.data.map(x => '<tr>' + keys.map(k => '<td>' + ((x[k] ?? '')) + '</td>').join('') + '</tr>').join(''); } };</script>
</body>
</html>
