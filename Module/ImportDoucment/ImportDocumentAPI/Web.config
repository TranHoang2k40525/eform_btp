    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <appSettings><add key="AiUrl" value="http://127.0.0.1:8010/parse"/><add key="UseMockAi" value="false"/><add key="AiUploadDir" value="..\..\AI Import\Main\runtime\uploads"/><add key="AiTimeoutSeconds" value="60"/><add key="MySqlDatabase" value="importai"/><add key="MockAiFile" value="App_Data\mock-ai-response.txt"/>
