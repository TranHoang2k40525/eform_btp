    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
  </appSettings>
  <connectionStrings>
    <add name="ImportDb" connectionString="Server=localhost;Port=3306;Database=importai;Uid=root;Pwd=123456;SslMode=None;AllowPublicKeyRetrieval=True;" providerName="MySql.Data.MySqlClient" />
  </connectionStrings>
  <system.data>
